### Copy this to `.env` and update values for your environment.
# Do NOT commit your `.env` file to source control. Use CI/Secrets for production.

# PostgreSQL — Supabase example
# Format: postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DATABASE_URL=postgresql://postgres:your_supabase_db_password@db.<project-ref>.supabase.co:5432/postgres?schema=public

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT
# Replace with a long, random value in production (e.g., 32+ chars from a secure generator)
JWT_SECRET=replace_this_with_a_long_random_value
JWT_EXPIRES_IN=7d

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
