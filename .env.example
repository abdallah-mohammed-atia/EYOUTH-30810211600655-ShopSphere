### Copy this to `.env` and update values for your environment.
# Do NOT commit your `.env` file to source control. Use CI/Secrets for production.

# PostgreSQL — replace placeholders with real values in your local `.env`
# Example: DATABASE_URL=postgresql://dbuser:strongpassword@db-host:5432/ecommerce?schema=public
DB_NAME=<your_database_name>
DB_USER=<your_database_user>
DB_PASSWORD=<your_database_password>
DB_HOST=<your_database_host>
DB_PORT=5432
DATABASE_URL=<your_full_database_url>

# MongoDB
MONGODB_URI=<your_mongodb_connection_uri>

# JWT
# Replace with a long, random value in production (e.g., 32+ chars from a secure generator)
JWT_SECRET=<your_jwt_secret>
JWT_EXPIRES_IN=7d

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
