### Copy this to `.env` and update values for your environment.
# Do NOT commit your `.env` file to source control. Use CI/Secrets for production.

# PostgreSQL
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT
# Replace with a long, random value in production (e.g., 32+ chars from a secure generator)
JWT_SECRET=replace_this_with_a_long_random_value
JWT_EXPIRES_IN=7d

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
MONGODB_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=replace_this_with_a_long_random_string
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
