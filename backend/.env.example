NODE_ENV=development
PORT=5000

# PostgreSQL — replace placeholders with real values in your local `.env`
# Example: DATABASE_URL=postgresql://dbuser:strongpassword@db-host:5432/ecommerce?schema=public
DB_HOST=<your_database_host>
DB_PORT=5432
DB_NAME=<your_database_name>
DB_USER=<your_database_user>
DB_PASSWORD=<your_database_password>
DATABASE_URL=<your_full_database_url>

# MongoDB
MONGODB_URI=<your_mongodb_connection_uri>

# Auth
JWT_SECRET=<your_jwt_secret>
JWT_EXPIRES_IN=7d

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
