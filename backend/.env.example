NODE_ENV=development
PORT=5000

# PostgreSQL — Supabase example
# Example: DATABASE_URL=postgresql://postgres:your_password@db.<project-ref>.supabase.co:5432/postgres?schema=public
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DATABASE_URL=postgresql://postgres:your_supabase_db_password@db.<project-ref>.supabase.co:5432/postgres?schema=public

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ecommerce

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
